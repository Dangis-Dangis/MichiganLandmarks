# Copy this file to .env and fill in values. .env is gitignored.
# Get a free key: https://www.nps.gov/subjects/developer/get-started.htm
NPS_API_KEY=

# JDK 21 root (not the bin/ folder). Needed for CLI Gradle APK builds.
# Typical Android Studio install on Windows:
# JAVA_HOME=C:\Program Files\Android\Android Studio\jbr
JAVA_HOME=

# Opt-in: geocode Wikipedia museum leftovers via Nominatim (slow; often 429).
# Leave unset for routine builds — Wikidata + IMLS already supply coordinates.
# MUSEUM_GEOCODE=1
