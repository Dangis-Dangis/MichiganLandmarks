{"id": "museum:wikipedia:paulson-house", "name": "Paulson House", "category": "museum", "latitude": 46.40694444, "longitude": -86.85027778, "subtype": "Historic house", "description": "1884 Swedish log house", "official_url": "https://en.wikipedia.org/wiki/Paulson_House_(AuTrain,_Michigan)", "significant_date": "2012", "date_type": "listed", "year": 2012, "image_url": "https://services3.arcgis.com/Jdnp1TjADvSDxMAX/arcgis/rest/services/Historical_Markers_Public_View/FeatureServer/0/765/attachments/2581", "image_credit": "Michigan History Center", "image_license": "Michigan DNR Open Data", "source": "Wikipedia", "source_id": "paulson-house", "source_url": "https://en.wikipedia.org/wiki/List_of_museums_in_Michigan", "data_license": "CC BY-SA 4.0", "last_fetched": "2026-09-06T00:23:46.397602+00:00", "county": "Alger", "city": "Au Train", "address": null, "region": "Eastern UP", "water_body": null, "tags": ["also_nrhp_site", "also_historical_marker"], "attributes": {"museum_sources": ["Wikipedia"], "geocode_query": "Paulson House, Au Train, Michigan", "geocode_precision": "article", "geocode_via": "wikipedia_summary", "description_source": "Wikipedia", "description_license": "CC BY-SA 4.0", "marker_text": "Paulson House\nSwedish pioneer Charles Paulson purchased one hundred acres of land here in 1884 and constructed this cabin for his family home. Built of hand hewn cedar logs securely dovetailed at the corners, the house was occupied by Paulson and his wife until their deaths in 1925. At the turn of the century the three Paulson daughters were able to attend the district school which met in the upper story. Today the restored Paulson House serves as a museum of pioneer life.", "merged_from": [{"id": "nrhp_site:nrhp:72000590", "source": "NRHP", "category": "nrhp_site"}, {"id": "historical_marker:mi-dnr-markers:mhc021972023", "source": "MI-DNR-Markers", "category": "historical_marker"}]}}